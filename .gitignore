outputs/qa/
outputs/*/qa/
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
# over GitHub's 100 MB limit: committed zipped (*.gpkg.zip); the freeze hash is of the unzipped file
outputs/pak-afg-irn/*.gpkg
outputs/irn/
